{
  "name": "bikebuddy-functions",
  "version": "1.0.0",
  "description": "BikeBuddy Azure Functions backend",
  "main": "src/**/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "func start",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "node scripts/check-coverage.js",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/test-results.xml",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:ci": "vitest run --config vitest.integration.config.js --reporter=default --reporter=junit --outputFile.junit=reports/integration-results.xml",
    "lint": "eslint src/ test/ --no-error-on-unmatched-pattern",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/functions": "^4.16.2",
    "@azure/storage-blob": "^12.33.0",
    "busboy": "^1.6.0",
    "exif-reader": "^2.0.3",
    "fast-xml-parser": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
