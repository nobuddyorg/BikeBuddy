{
  "name": "bikebuddy-functions",
  "version": "1.0.0",
  "description": "BikeBuddy Azure Functions backend",
  "main": "src/**/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "func start",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "node scripts/check-coverage.js",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/test-results.xml",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:ci": "vitest run --config vitest.integration.config.js --reporter=default --reporter=junit --outputFile.junit=reports/integration-results.xml",
    "lint": "eslint src/ test/ scripts/ --max-warnings 0",
    "typecheck": "tsc -p . && tsc -p ../frontend",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'",
    "mutate": "stryker run",
    "mutation:summary": "node scripts/mutation-summary.mjs --title 'Mutation testing (functions)'"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/functions": "^4.16.2",
    "@azure/storage-blob": "^12.33.0",
    "busboy": "^1.6.0",
    "exif-reader": "^2.0.3",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "mutation-testing-metrics": "^3.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
