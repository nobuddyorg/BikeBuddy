{
  "name": "bikebuddy-e2e",
  "version": "1.0.0",
  "description": "Playwright end-to-end UI tests for BikeBuddy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "format": "prettier --write '**/*.ts'",
    "format:check": "prettier --check '**/*.ts'",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p .",
    "lighthouse": "node lighthouse/run.mjs",
    "lighthouse:summary": "node lighthouse/summary.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/storage-blob": "^12.34.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "monocart-coverage-reports": "^2.13.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "^14.0.2"
  }
}
