{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Only what Knip's static analysis cannot follow, each with its reason.
  "entry": [
    // Named only as a string in stryker.config.mjs (vitest.configFile).
    "vitest.mutation.config.js",
    // Loaded by index.html's <script type="module">; no bundler resolves it.
    "src/app.js",
    // Loaded the same way by privacy.html, the privacy notice (#542).
    "src/privacy.js",
    // Registered by string in navigator.serviceWorker.register().
    "src/sw.js",
  ],
  "project": ["src/**/*.js", "test/**/*.js"],
  "ignore": [
    // Vendored upstream bundles loaded by <script> tags, kept byte-identical.
    "src/vendor/**",
  ],
  "ignoreDependencies": [
    // Pinned so Dependabot bumps them; scripts/quality/verify-vendor.mjs compares src/vendor/ with them.
    "@azure/msal-browser",
    "leaflet",
  ],
}
